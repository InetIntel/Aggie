# The production frontend build (react-scripts) requires devDependencies:
# @types/* (TypeScript declarations — missing ones are FATAL TS7016 errors,
# not warnings), tailwindcss (PostCSS build step), and cross-env.
# The prod deploy (startAggie.sh) exports NODE_ENV=production before `npm ci`,
# which would otherwise omit devDependencies and break `npm run build`.
# include=dev overrides that so installs always include devDependencies.
include=dev
